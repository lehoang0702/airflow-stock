# ==============================
# Airflow Stock — Environment Variables
# ==============================
# Copy file này thành .env và điền giá trị thật trước khi chạy docker compose.

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW_SECRET_KEY=thay_bang_chuoi_ngau_nhien_dai
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# --- PostgreSQL ---
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Telegram Bot (để nhận cảnh báo & báo cáo) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
